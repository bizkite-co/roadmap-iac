{
  "dependencies": {
    "@aws-cdk/aws-codebuild": "^1.204.0",
    "@aws-cdk/aws-codepipeline": "^1.121.0",
    "@aws-cdk/aws-codepipeline-actions": "^1.121.0",
    "@aws-cdk/aws-events": "^1.32.2",
    "@aws-cdk/aws-events-targets": "^1.121.0",
    "@aws-cdk/aws-iam": "^1.204.0",
    "@aws-cdk/aws-lambda": "^1.2.0",
    "@aws-cdk/aws-s3": "^1.204.0",
    "@aws-cdk/core": "^1.204.0",
    "@aws-cdk/pipelines": "^1.204.0",
    "aws-cdk-lib": "^2.195.0",
    "constructs": "^10.3.0",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "sudo ./scripts/build_war.sh",
    "clean": "sudo ./gradlew clean war",
    "cdk-synth": "cd cdk ; npx cdk synth ; cd ..",
    "cdk-deploy": "./scripts/pre_cdk_deploy.sh",
    "cdk-destroy": "cd cdk ; npx cdk destroy --require-approval never ; cd ..",
    "view-codedeploy-logs": "./scripts/view_codedeploy_logs.sh",
    "get-deployment-status": "./scripts/get_deployment_status.sh",
    "get-pipeline-status": "aws codepipeline get-pipeline-state --name RoadmapWebAppPipeline | jq '.stageStates[] | {stageName: .stageName, status: .latestExecution.status}'",
    "start-pipeline-execution": "aws codepipeline start-pipeline-execution --name RoadmapWebAppPipeline",
    "rollback": "./scripts/rollback.sh",
    "get-failed-deployment-logs": "./scripts/get_failed_deployment_logs.sh",
    "deploy-prod": "./deploy_prod.sh",
    "deploy-uat": "./deploy_uat.sh",
    "restore-prod": "./restore_prod.sh",
    "uat-status": "./uat_control.sh status",
    "uat-ip": "./uat_control.sh ip",
    "uat-start": "./uat_control.sh start",
    "uat-stop": "./uat_control.sh stop",
    "deploy-uat-manual": "./scripts/deploy_uat_manual.sh",
    "start:prod": " ssh $prod 'sudo /opt/tomcat/apache-tomcat-9.0.53/bin/startup.sh'",
    "test:e2e": "./scripts/run-e2e-tests.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
